<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false"
        app:surface_type="surface_view"/>

    <!-- OSD: número + logo + nome + EPG (parte de baixo) -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#A0000000"
        android:visibility="gone">
        <TextView
            android:id="@+id/osdNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fg"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginEnd="20dp"/>
        <ImageView
            android:id="@+id/osdLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="20dp"
            android:scaleType="fitCenter"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/osdName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fg"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/osdEpg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fg_muted"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- Overlay da lista de canais (sobre o player; vídeo continua tocando) -->
    <FrameLayout
        android:id="@+id/listOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:focusable="true"
        android:clickable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/listTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Canais"
                android:textColor="@color/fg"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                android:focusable="true"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Menu de Configurações (tecla MENU) -->
    <FrameLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:visibility="gone"
        android:focusable="true"
        android:clickable="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="32dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙️ Configurações"
                android:textColor="@color/fg"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="16dp"/>
            <TextView
                android:id="@+id/menuUserInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fg_muted"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingBottom="20dp"/>
            <LinearLayout
                android:id="@+id/menuItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="↑↓ navegar • OK selecionar • Voltar fechar"
                android:textColor="@color/fg_muted"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingTop="20dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Overlay de Estatísticas (sequência secreta) -->
    <LinearLayout
        android:id="@+id/statsOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#D0000000"
        android:minWidth="320dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Estatísticas"
            android:textColor="#dc2626"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>
        <TextView
            android:id="@+id/statsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OK ou Voltar fecha"
            android:textColor="@color/fg_muted"
            android:textSize="11sp"
            android:paddingTop="8dp"
            android:gravity="end"/>
    </LinearLayout>
</FrameLayout>
