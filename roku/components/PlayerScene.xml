<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScene" extends="Group">
  <interface>
    <field id="channelData" type="assocarray" alwaysNotify="true" />
    <field id="channelList" type="array" />
    <field id="channelIndex" type="integer" value="0" />
    <field id="favorites" type="array" />
    <field id="favoritesChanged" type="assocarray" alwaysNotify="true" />
    <field id="playerClosed" type="boolean" alwaysNotify="true" />
    <field id="adultPin" type="string" value="1234" />
    <field id="unlockedIds" type="assocarray" />
    <field id="pinCategoryIds" type="assocarray" />
    <field id="unlockRequest" type="assocarray" alwaysNotify="true" />
    <field id="revertRestricted" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PlayerScene.brs" />
  <script type="text/brightscript" uri="pkg:/source/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/source/EpgClient.brs" />
  <script type="text/brightscript" uri="pkg:/source/SupabaseAuth.brs" />
  <script type="text/brightscript" uri="pkg:/source/SupabaseRest.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000ff" />
    <Video id="video" width="1920" height="1080" translation="[0, 0]" />

    <!-- OSD inferior -->
    <Rectangle id="osdBg" width="1920" height="180" translation="[0, 900]" color="0x000000cc" visible="false" />
    <Label id="osdName" text="" font="font:LargeBoldSystemFont"
           color="0xffffffff" translation="[60, 920]" visible="false" />
    <Label id="osdNum" text="" font="font:MediumSystemFont"
           color="0xdc2626ff" translation="[60, 970]" visible="false" />
    <Label id="osdNow" text="" font="font:MediumBoldSystemFont"
           color="0xffffffff" translation="[700, 920]" width="1160" visible="false" />
    <Label id="osdNext" text="" font="font:SmallSystemFont"
           color="0x9ca3afff" translation="[700, 970]" width="1160" visible="false" />
    <Label id="osdHint" text="▲ Favoritos  •  ◀ ▶ pré-visualizar  •  OK lista  •  segure OK p/ favoritar"
           font="font:SmallSystemFont" color="0x6b7280ff"
           translation="[60, 1040]" visible="false" />

    <!-- Barra de favoritos (acima do OSD) -->
    <Rectangle id="favBg" width="1920" height="260" translation="[0, 620]" color="0x000000d9" visible="false" />
    <Label id="favTitle" text="★ Favoritos" font="font:MediumBoldSystemFont"
           color="0xfbbf24ff" translation="[60, 635]" visible="false" />
    <Group id="favBar" translation="[60, 680]" visible="false" />

    <!-- Lista cheia de canais (OK 2x) -->
    <Rectangle id="listBg" width="780" height="1080" translation="[0, 0]" color="0x000000ee" visible="false" />
    <Label id="listTitle" text="Canais" font="font:LargeBoldSystemFont"
           color="0xdc2626ff" translation="[60, 40]" visible="false" />
    <LabelList id="chOverlay"
               translation="[60, 110]"
               itemSize="[680, 60]"
               numRows="14"
               focusBitmapBlendColor="0xdc2626ff"
               color="0xffffffff"
               focusedColor="0xffffffff"
               visible="false" />

    <!-- Toast -->
    <Rectangle id="toastBg" width="600" height="80" translation="[660, 80]" color="0x111827ee" visible="false" />
    <Label id="toastLabel" text="" font="font:MediumBoldSystemFont"
           color="0xfbbf24ff" translation="[660, 100]" width="600" horizAlign="center" visible="false" />

    <Label id="errLabel" text="" font="font:MediumSystemFont"
           color="0xfca5a5ff" translation="[60, 60]" visible="false" />

    <Timer id="osdTimer" repeat="false" duration="5" />
    <Timer id="longPressTimer" repeat="false" duration="0.55" />
    <Timer id="toastTimer" repeat="false" duration="2" />
  </children>
</component>
