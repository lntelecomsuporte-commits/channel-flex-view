               translation="[60, 200]"
               itemSize="[360, 64]"
               numRows="11"
               focusBitmapBlendColor="0xdc2626ff"
               color="0xffffffff"
               focusedColor="0xffffffff" />

    <!-- Canais (direita) -->
    <LabelList id="chList"
               translation="[460, 200]"
               itemSize="[700, 64]"
               numRows="11"
               focusBitmapBlendColor="0xdc2626ff"
               color="0xffffffff"
               focusedColor="0xffffffff" />

    <Label id="hint"
           text="OK: assistir   ★ (info): favoritar   ◀ ▶: trocar coluna   Voltar: sair"
           font="font:SmallSystemFont" color="0x6b7280ff"
           translation="[60, 1020]" />
