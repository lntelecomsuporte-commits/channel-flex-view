    <field id="logoutRequested" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/HomeScene.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x0a0a0aff" />

    <Label id="brand" text="LN TV" font="font:LargeBoldSystemFont"
           color="0xdc2626ff" translation="[60, 40]" />
    <Label id="status" text="Carregando..." font="font:MediumSystemFont"
           color="0x9ca3afff" translation="[60, 120]" />

    <!-- Categorias (esquerda) -->
