<?xml version="1.0" encoding="utf-8" ?>
<component name="LoginScene" extends="Group">
  <interface>
    <field id="loginOk" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/LoginScene.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x0a0a0aff" />
    <Label id="title" text="LN TV" font="font:LargeBoldSystemFont" color="0xdc2626ff"
           translation="[860, 240]" width="200" horizAlign="center" />
